{
  "$schema": "tool_schema.json",
  "description": "命名规范与 MCP 工具注册表 — 定义 server/tool 的 verb-noun 模式",
  "naming_convention": {
    "server": {
      "name": "{verb}-{noun}",
      "file": "{verb}_{noun}_server.ts"
    },
    "tool": {
      "name": "{verb}_{noun}",
      "file": "{verb}_{noun}.ts"
    }
  },
  "servers": [
    {
      "verb": "run",
      "noun": "code",
      "description": "Execute code in sandboxed runtimes",
      "tools": [
        {
          "noun": "python",
          "description": "Execute Python code"
        },
        {
          "noun": "r",
          "description": "Execute R code in sandbox"
        },
        {
          "noun": "shell",
          "description": "Run shell commands"
        }
      ]
    },
    {
      "verb": "get",
      "noun": "env-info",
      "description": "Fetch categorized host environment info",
      "tools": [
        {
          "noun": "system_info",
          "description": "Host OS information"
        },
        {
          "noun": "cpu_info",
          "description": "Processor model and cores"
        },
        {
          "noun": "memory_info",
          "description": "Physical memory usage"
        },
        {
          "noun": "disk_info",
          "description": "C: drive disk usage"
        },
        {
          "noun": "gpu_info",
          "description": "GPU adapters"
        },
        {
          "noun": "runtime_info",
          "description": "Installed dev tools and runtimes"
        }
      ]
    }
  ],
  "cross_checks": {
    "mcp_json": ".mcp.json"
  }
}